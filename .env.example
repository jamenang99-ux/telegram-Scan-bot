# Get this from @BotFather after /newbot
BOT_TOKEN=123456789:***

# Mini App API server port (default 3001)
API_PORT=3001

# Public HTTPS URL where the Mini App frontend is hosted (e.g. https://your-domain.com)
# Leave empty to use t.me/<botname>/app fallback
APP_URL=

# Optional: chat_id of a private admin log channel/group (add bot as admin there too)
LOG_CHAT_ID=

# Optional: VirusTotal API key (public tier) for file hash lookups
VT_API_KEY=
NGROK_AUTH_TOKEN=
